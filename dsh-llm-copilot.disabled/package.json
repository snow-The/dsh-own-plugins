{
  "name": "@snow-the/dsh-llm-copilot",
  "version": "0.1.1",
  "description": "DSH LLM provider adapter for GitHub Copilot (chat/completions via gh token). Student plan models: gpt-4o / gpt-4o-mini / gpt-4.1 / gpt-3.5-turbo.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --emitDeclarationOnly && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:@deepseek-ai/*",
    "test": "node --test"
  },
  "keywords": [
    "dsh",
    "plugin",
    "llm",
    "copilot",
    "provider"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "eventsource-parser": "^3.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@types/node": "^22.20.1",
    "esbuild": "^0.24.2",
    "typescript": "^5.9.3"
  }
}
